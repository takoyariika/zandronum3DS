diff --git a/dumb/src/it/itrender.c b/dumb/src/it/itrender.c
index ba31a87f0..2e4712ec7 100644
--- a/dumb/src/it/itrender.c
+++ b/dumb/src/it/itrender.c
@@ -63,8 +63,19 @@ static IT_PLAYING *new_playing(DUMB_IT_SIGRENDERER *itsr)
 	return r;
 }
 
+static void free_playing_orig(IT_PLAYING *r);
+
 static void free_playing(DUMB_IT_SIGRENDERER *itsr, IT_PLAYING *playing)
 {
+#ifdef __3DS__
+	/* XM instrument events clone playings even without starting a new note.
+	 * Those clones enter this pool faster than new_playing() consumes them.
+	 * Keep a bounded idle cache; active voices and their audio remain intact. */
+	IT_PLAYING *cached = itsr->free_playing;
+	int idle = 0;
+	while (cached && idle < 32) { cached = cached->next; ++idle; }
+	if (idle >= 32) { free_playing_orig(playing); return; }
+#endif
 	playing->next = itsr->free_playing;
 	itsr->free_playing = playing;
 }
